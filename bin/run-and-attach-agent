#!/usr/bin/env bash
# run-and-attach-agent — start the agent (if not running) and attach.
#
# Loops on the attach so that detaching (Ctrl+B D) drops back to a watchdog
# loop that reattaches if the session is still up, or recreates and
# reattaches if it died. Ctrl+C exits the loop.
#
# Usage:
#   bin/run-and-attach-agent             # start (if needed) + attach loop
#   bin/run-and-attach-agent -h | --help # print this help
#
# Spec: docs/specs/start-agent.md

# todo use mise to install gum from charmbracelet to improve the output here
# (only temporary till we move to nsheaps/agents)

set -uo pipefail

usage() {
  cat <<'EOF'
run-and-attach-agent — start the agent (if needed) and attach

Usage:
  bin/run-and-attach-agent             Start agent if not running, then attach.
                                       Loops on detach: re-attaches or recreates.
  bin/run-and-attach-agent -h | --help Print this help.

To start without attaching: bin/run-agent
To attach to an existing session: bin/attach-agent

Spec: docs/specs/start-agent.md
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=./lib/tmux.sh
source "$REPO_DIR/bin/lib/tmux.sh"

# Read from <repo>/agent.yaml (key: name) — see bin/run-agent for rationale.
AGENT_NAME="$(grep -E '^[[:space:]]*name:[[:space:]]*' "$REPO_DIR/agent.yaml" 2>/dev/null | head -1 | sed -E 's/^[[:space:]]*name:[[:space:]]*//; s/[[:space:]]*$//; s/^"(.*)"$/\1/; s/^'"'"'(.*)'"'"'$/\1/')"
if [[ -z "$AGENT_NAME" ]]; then
  echo "ERROR: could not read 'name:' from $REPO_DIR/agent.yaml" >&2
  exit 1
fi
export AGENT_NAME

handle_interrupt() {
  echo "Ctrl+C pressed. Exiting..."
  KEEP_LOOPING=0
  exit 0
}
trap handle_interrupt SIGINT

KEEP_LOOPING=1
while [[ $KEEP_LOOPING -eq 1 ]]; do
  if ! tmux_session_exists "$AGENT_NAME"; then
    echo "tmux session for ${AGENT_NAME} not found. Starting new session..."
    tmux_make_session "$AGENT_NAME" "$REPO_DIR" "bash bin/start-agent"
    sleep 1
  fi
  if ! tmux_session_exists "$AGENT_NAME"; then
    echo "Failed to start tmux session for ${AGENT_NAME}. Retrying after 3s..."
    sleep 3
    continue
  else
    tmux_attach_session "$AGENT_NAME"
  fi
  sleep 3
done
